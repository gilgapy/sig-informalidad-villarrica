digraph ER {
  graph [rankdir=LR, bgcolor="white", nodesep=0.5, ranksep=1.1, fontname="Helvetica", dpi=200];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [color="#334155", arrowhead=crow, arrowtail=tee, dir=both, penwidth=1.2];
  barrios [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#E0E7FF"><B>barrios</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD><TD ALIGN="LEFT" PORT="id_out"><B>PK</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><I>+ 10 atributos</I></TD></TR></TABLE>>];
  canales_marketing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#E0E7FF"><B>canales_marketing</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_canal_in"><B>id_canal</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD><TD ALIGN="LEFT" PORT="id_canal_out"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo_in">codigo</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="codigo_out"><B>UQ</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><I>+ 4 atributos</I></TD></TR></TABLE>>];
  derivaciones_programas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#D1FAE5"><B>derivaciones_programas</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_derivacion_in"><B>id_derivacion</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD><TD ALIGN="LEFT" PORT="id_derivacion_out"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="canal_codigo_in">canal_codigo</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="canal_codigo_out"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="programa_id_in">programa_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="programa_id_out"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="trabajador_id_in">trabajador_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="trabajador_id_out"><B>FK</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><I>+ 5 atributos</I></TD></TR></TABLE>>];
  indicadores_sociales [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#D1FAE5"><B>indicadores_sociales</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_indicador_in"><B>id_indicador</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD><TD ALIGN="LEFT" PORT="id_indicador_out"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="trabajador_id_in">trabajador_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="trabajador_id_out"><B>FK</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><I>+ 13 atributos</I></TD></TR></TABLE>>];
  marketing_kpis [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#D1FAE5"><B>marketing_kpis</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_kpi_in"><B>id_kpi</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD><TD ALIGN="LEFT" PORT="id_kpi_out"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="canal_id_in">canal_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD><TD ALIGN="LEFT" PORT="canal_id_out"><B>FK</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><I>+ 13 atributos</I></TD></TR></TABLE>>];
  medios_pago [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#E0E7FF"><B>medios_pago</B></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo_in"><B>codigo</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="codigo_out"><B>PK</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><I>+ 4 atributos</I></TD></TR></TABLE>>];
  oficios [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#E0E7FF"><B>oficios</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD><TD ALIGN="LEFT" PORT="id_out"><B>PK</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><I>+ 5 atributos</I></TD></TR></TABLE>>];
  programas_formalizacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#E0E7FF"><B>programas_formalizacion</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_programa_in"><B>id_programa</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="id_programa_out"><B>PK</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><I>+ 9 atributos</I></TD></TR></TABLE>>];
  rubros_mypes [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#E0E7FF"><B>rubros_mypes</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_in"><B>id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD><TD ALIGN="LEFT" PORT="id_out"><B>PK</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><I>+ 6 atributos</I></TD></TR></TABLE>>];
  trabajadores [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#D1FAE5"><B>trabajadores</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_trabajador_in"><B>id_trabajador</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="id_trabajador_out"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="barrio_id_in">barrio_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD><TD ALIGN="LEFT" PORT="barrio_id_out"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="oficio_id_in">oficio_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD><TD ALIGN="LEFT" PORT="oficio_id_out"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="unidad_productiva_id_in">unidad_productiva_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="unidad_productiva_id_out"><B>FK</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><I>+ 16 atributos</I></TD></TR></TABLE>>];
  trabajadores_medios_pago [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#FEF3C7"><B>trabajadores_medios_pago</B></TD></TR><TR><TD ALIGN="LEFT" PORT="trabajador_id_in"><B>trabajador_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="trabajador_id_out"><B>PK FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="medio_pago_codigo_in"><B>medio_pago_codigo</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="medio_pago_codigo_out"><B>PK FK</B></TD></TR></TABLE>>];
  unidades_medios_pago [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#FEF3C7"><B>unidades_medios_pago</B></TD></TR><TR><TD ALIGN="LEFT" PORT="unidad_id_in"><B>unidad_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="unidad_id_out"><B>PK FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="medio_pago_codigo_in"><B>medio_pago_codigo</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="medio_pago_codigo_out"><B>PK FK</B></TD></TR></TABLE>>];
  unidades_productivas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD COLSPAN="3" BGCOLOR="#D1FAE5"><B>unidades_productivas</B></TD></TR><TR><TD ALIGN="LEFT" PORT="id_unidad_in"><B>id_unidad</B></TD><TD ALIGN="LEFT"><FONT COLOR="#475569">varchar</FONT></TD><TD ALIGN="LEFT" PORT="id_unidad_out"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="barrio_id_in">barrio_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD><TD ALIGN="LEFT" PORT="barrio_id_out"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" PORT="rubro_id_in">rubro_id</TD><TD ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD><TD ALIGN="LEFT" PORT="rubro_id_out"><B>FK</B></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT"><I>+ 13 atributos</I></TD></TR></TABLE>>];
  unidades_productivas:id_unidad_out:e -> trabajadores:unidad_productiva_id_in:w;
  barrios:id_out:e -> unidades_productivas:barrio_id_in:w;
  rubros_mypes:id_out:e -> unidades_productivas:rubro_id_in:w;
  barrios:id_out:e -> trabajadores:barrio_id_in:w;
  oficios:id_out:e -> trabajadores:oficio_id_in:w;
  trabajadores:id_trabajador_out:e -> indicadores_sociales:trabajador_id_in:w;
  canales_marketing:id_canal_out:e -> marketing_kpis:canal_id_in:w;
  canales_marketing:codigo_out:e -> derivaciones_programas:canal_codigo_in:w;
  programas_formalizacion:id_programa_out:e -> derivaciones_programas:programa_id_in:w;
  trabajadores:id_trabajador_out:e -> derivaciones_programas:trabajador_id_in:w;
  trabajadores:id_trabajador_out:e -> trabajadores_medios_pago:trabajador_id_in:w;
  medios_pago:codigo_out:e -> trabajadores_medios_pago:medio_pago_codigo_in:w;
  unidades_productivas:id_unidad_out:e -> unidades_medios_pago:unidad_id_in:w;
  medios_pago:codigo_out:e -> unidades_medios_pago:medio_pago_codigo_in:w;
}